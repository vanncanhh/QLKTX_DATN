@model TECH.Areas.Admin.Models.DotDangKyKTXModelView
@{
    ViewData["Title"] = "Tạo đợt đăng ký";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}
<div class="card">
    <div class="card-header"><h4>Thêm đợt đăng ký</h4></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label asp-for="TenDot"></label>
                <input asp-for="TenDot" class="form-control" />
                <span asp-validation-for="TenDot" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianBatDau"></label>
                <input asp-for="ThoiGianBatDau" type="datetime-local" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="ThoiGianKetThuc"></label>
                <input asp-for="ThoiGianKetThuc" type="datetime-local" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="MoTa"></label>
                <textarea asp-for="MoTa" class="form-control"></textarea>
            </div>
            <button type="submit" class="btn btn-success">Tạo mới</button>
            <a asp-action="Index" class="btn btn-secondary">Hủy</a>
        </form>
    </div>
</div>
